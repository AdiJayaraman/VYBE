# Server
PORT=4000
NODE_ENV=development
# Comma-separated allowlist for REST + Socket.IO. Leave empty in development
# (origins are reflected); set it in production.
CORS_ORIGINS=

# Public origin used to build absolute media URLs (uploads)
PUBLIC_API_URL=http://localhost:4000

# Database (must match packages/database/.env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vybe?schema=public"
# Optional: max pg pool connections (default 10)
VYBE_PG_POOL_MAX=

# Demo/dev access tokens. Replace in production.
JWT_SECRET="vybe-dev-secret-change-me"

# Optional Supabase Auth integration (JWT verification only)
# Supabase now signs with ES256; tokens are verified against the project JWKS.
SUPABASE_URL=
SUPABASE_JWKS_URL=
# Legacy HS256 projects only
SUPABASE_JWT_SECRET=

# Optional Gemini API key. Without it, the AI Room Builder uses the
# deterministic fallback layout generator. Model: gemini-3.1-flash-lite.
GEMINI_API_KEY=

# Proximity voice (LiveKit Cloud). Server-only secrets — never expose the API secret.
# wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
