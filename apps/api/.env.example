# Server
PORT=4000
NODE_ENV=development

# Database (must match packages/database/.env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vybe?schema=public"

# Demo/dev access tokens. Replace in production.
JWT_SECRET="vybe-dev-secret-change-me"

# Optional Supabase Auth integration (JWT verification only)
SUPABASE_JWT_SECRET=
SUPABASE_URL=

# Optional Gemini API key. Without it, the AI Room Builder uses the
# deterministic fallback layout generator.
GEMINI_API_KEY=
