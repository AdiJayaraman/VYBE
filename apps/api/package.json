{
  "name": "@vybe/api",
  "version": "0.1.0",
  "private": true,
  "description": "VYBE NestJS REST + Socket.IO backend",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/platform-socket.io": "^12.5.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.5.0",
    "@vybe/3d-core": "workspace:*",
    "@vybe/database": "workspace:*",
    "@vybe/shared-types": "workspace:*",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "livekit-server-sdk": "^2.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
